# Public site URL, no trailing slash
NEXT_PUBLIC_BASE_URL=http://localhost:3012

# Session signing secret (any long random string)
SESSION_SECRET=

# --- Payments -------------------------------------------------------------
# Without a Stripe secret key the checkout runs in demo mode: no card data is
# collected anywhere and no real payment is taken. Add the keys to go live.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (optional alternative). Same rule: empty = demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Email ----------------------------------------------------------------
# Without RESEND_API_KEY every message is written to data/runtime/outbox.json
RESEND_API_KEY=
MAIL_FROM="Nucera Estate <no-reply@nucera-estate.com>"
